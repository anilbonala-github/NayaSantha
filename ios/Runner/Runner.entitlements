<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for App Store / TestFlight builds. The App ID must have
	     the Push Notifications capability enabled so the distribution profile matches. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
